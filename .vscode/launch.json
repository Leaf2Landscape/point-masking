    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "-m", "~/projects/ROBSON_segfix_test/trees/train",
                "-t", "~/projects/ROBSON_segfix_test/individual_trees/matched",
                "-o", "~/projects/ROBSON_segfix_test/masked_output",
                "-d", "0.7"
            ]
        }
    ]
}